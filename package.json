{
  "name": "api",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register --inspect --transpile-only --ignore-watch node_modules src/shared/http/server.ts",
    "build": "tsc",
    "start": "ts-node -r tsconfig-paths/register --transpile-only src/shared/http/server.ts",
    "lint": "eslint . --ext .ts",
    "lint-fix": "eslint . --ext .ts --fix",
    "typeorm": "ts-node --transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "typeorm:migrate": "ts-node --transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run",
    "typeorm:revert": "ts-node --transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert",
    "seed": "ts-node --transpile-only -r tsconfig-paths/register ./src/shared/typeorm/seeds/index.ts",
    "test": "vitest --run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^5.10.1",
    "@typescript-eslint/parser": "^5.10.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.8.0",
    "eslint-config-prettier": "6.15.0",
    "eslint-plugin-prettier": "3.2.0",
    "prettier": "^2.5.1",
    "ts-node-dev": "^1.1.8",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^8.6.0",
    "express": "^4.17.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.7.1",
    "reflect-metadata": "^0.1.13",
    "ts-node": "^9.1.1",
    "tsconfig-paths": "^3.12.0",
    "typeorm": "^0.2.41",
    "typescript": "^4.5.5"
  }
}

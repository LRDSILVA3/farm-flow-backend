# ==========================================
# FARM FLOW BACKEND - ENVIRONMENT VARIABLES
# ==========================================

# Server Configuration
PORT=3333
NODE_ENV=production
APP_SECRET=farmflow-secret-key-2026

# Database Configuration (Option 1: Direct Parameters)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SSL=false

# Database Configuration (Option 2: Connection URL used by Coolify / Supabase / Neon)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Deployment Startup Controls
RUN_MIGRATIONS=true
RUN_SEED=false
